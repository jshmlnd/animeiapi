{
  "name": "animeiapi",
  "version": "1.0.0",
  "description": "animeiAPI – anime metadata + streaming API (AniList GraphQL for metadata, Miruro secure pipe for M3U8 sources)",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "echo \"Add tests for your endpoints\""
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "eslint": "^10.10.0",
    "express": "^4.19.0",
    "node-cache": "^5.1.2"
  },
  "optionalDependencies": {
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "wrangler": "^4.129.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260907.1": true
  }
}
